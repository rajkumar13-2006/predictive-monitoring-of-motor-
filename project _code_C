#include <math.h>

// MOTOR DRIVER
#define IN1 26
#define IN2 27

// GREEN LED
#define GREEN_LED 32

// DS18B20
#define ONE_WIRE_BUS 4
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature tempSensor(&oneWire);

// MPU6500
#define MPU_ADDR 0x68

// LORA SX1278
#define LORA_SS   5
#define LORA_RST  14
#define LORA_DIO0 2

// TIMING
const unsigned long SEND_INTERVAL = 1000;
unsigned long lastSend = 0;

// SENSOR DATA
float temperatureC = NAN;
float vibrationG = -1.0;

// INITIALIZE MPU6500
bool initMPU() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);

  if (Wire.endTransmission() != 0) return false;

  delay(100);

  // Accelerometer range +/- 8g
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1C);
  Wire.write(0x10);

  if (Wire.endTransmission() != 0) return false;

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x75);

  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(MPU_ADDR, 1) != 1) return false;

  byte id = Wire.read();

  Serial.print("MPU WHO_AM_I: 0x");
  Serial.println(id, HEX);

  return (id == 0x70 || id == 0x71 || id == 0x68);
}

// READ VIBRATION
float readVibration() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);

  if (Wire.endTransmission(false) != 0) return -1.0;
  if (Wire.requestFrom(MPU_ADDR, 6) != 6) return -1.0;

  int16_t ax = (Wire.read() << 8) | Wire.read();
  int16_t ay = (Wire.read() << 8) | Wire.read();
  int16_t az = (Wire.read() << 8) | Wire.read();

  float xg = ax / 4096.0;
  float yg = ay / 4096.0;
  float zg = az / 4096.0;

  float totalG = sqrt(xg * xg + yg * yg + zg * zg);

  // Simple acceleration deviation estimate
  return fabs(totalG - 1.0);
}

// SEND DATA THROUGH LORA
void sendData() {
  char packet[64];

  snprintf(packet, sizeof(packet),
           "TEMP:%.2f,VIB:%.2f",
           temperatureC, vibrationG);

  Serial.print("Sending: ");
  Serial.println(packet);

  LoRa.beginPacket();
  LoRa.print(packet);

  int result = LoRa.endPacket();

  if (result == 1) {
    Serial.println("LoRa transmission completed");
  } else {
    Serial.println("LoRa transmission failed");
  }

  Serial.println("-------------------------");
}

// SETUP
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("PREDICTIVE MAINTENANCE");
  Serial.println("ESP32 TRANSMITTER");

  // Motor driver
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  // Green LED continuously ON
  pinMode(GREEN_LED, OUTPUT);
  digitalWrite(GREEN_LED, HIGH);

  // Temperature sensor
  tempSensor.begin();

  // I2C
  Wire.begin(21, 22);

  if (initMPU()) {
    Serial.println("MPU6500 OK");
  } else {
    Serial.println("MPU6500 ERROR - Check wiring/address");
  }

  // LoRa initialization
  SPI.begin(18, 19, 23, LORA_SS);
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);

  if (!LoRa.begin(433E6)) {
    Serial.println("LoRa initialization FAILED");

    while (true) {
      digitalWrite(GREEN_LED, HIGH);
      delay(500);
    }
  }

  // Must match receiver settings
  LoRa.setSpreadingFactor(7);
  LoRa.setSignalBandwidth(125E3);
  LoRa.setCodingRate4(5);
  LoRa.setSyncWord(0x12);
  LoRa.enableCrc();
  LoRa.setTxPower(17);

  Serial.println("LoRa transmitter ready");
  Serial.println("GREEN LED GPIO32 = ON");
}

// MAIN LOOP
void loop() {
  // Keep Green LED ON
  digitalWrite(GREEN_LED, HIGH);

  // Read temperature
  tempSensor.requestTemperatures();
  float t = tempSensor.getTempCByIndex(0);

  if (t != DEVICE_DISCONNECTED_C && t >= -50 && t <= 125) {
    temperatureC = t;
  } else {
    Serial.println("DS18B20 ERROR");
  }

  // Read vibration
  vibrationG = readVibration();

  // Send data every second
  if (millis() - lastSend >= SEND_INTERVAL) {
    lastSend = millis();

    Serial.print("Temperature: ");
    Serial.println(temperatureC);

    Serial.print("Vibration: ");
    Serial.println(vibrationG);

    sendData();
  }

  delay(20);
}
